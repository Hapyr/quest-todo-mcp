app = "mein-todo"  # eigener, weltweit eindeutiger App-Name
primary_region = "fra"

[build]

[env]
  TODO_PUBLIC_URL = "https://mein-todo.fly.dev"
  TODO_TIMEZONE = "Europe/Berlin"

[[mounts]]
  source = "todo_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    grace_period = "10s"
    interval = "60s"
    method = "GET"
    path = "/healthz"
    timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
